{
  "name": "@arthurkim/memtop",
  "version": "0.0.4",
  "private": false,
  "description": "Treemap-based memory monitor for your terminal",
  "license": "MIT",
  "bin": {
    "memtop": "bin/memtop"
  },
  "files": [
    "bin/memtop",
    "vendor/",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "start": "scripts/cargo.sh run --quiet --",
    "dev": "scripts/cargo.sh run --quiet --",
    "treemap": "scripts/cargo.sh run --quiet --",
    "once": "scripts/cargo.sh run --quiet -- --once",
    "build": "scripts/cargo.sh build --release",
    "check": "scripts/cargo.sh check --locked",
    "test:launcher": "bash scripts/test-npm-launcher.sh",
    "test": "scripts/cargo.sh test --locked && bash scripts/test-npm-launcher.sh"
  },
  "packageManager": "pnpm@10.33.1",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kimdwkimdw/memtop.git"
  },
  "keywords": [
    "memory",
    "top",
    "htop",
    "monitor"
  ],
  "author": "Arthur Kim",
  "bugs": {
    "url": "https://github.com/kimdwkimdw/memtop/issues"
  },
  "homepage": "https://github.com/kimdwkimdw/memtop#readme"
}
