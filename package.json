{
  "name": "memtop",
  "version": "0.0.1",
  "private": false,
  "description": "Treemap-based memory monitor for your terminal",
  "license": "MIT",
  "type": "module",
  "bin": {
    "memtop": "./dist/bin/memtop.js"
  },
  "files": [
    "dist/",
    "vendor/",
    "README.md"
  ],
  "scripts": {
    "build:ts": "tsc -p tsconfig.json",
    "prepack": "npm run build:ts",
    "start": "pnpm run build:ts && node ./dist/bin/memtop.js",
    "dev": "pnpm run build:ts && node ./dist/bin/memtop.js",
    "treemap": "pnpm run build:ts && node ./dist/bin/memtop.js",
    "once": "pnpm run build:ts && node ./dist/bin/memtop.js --once",
    "build": "pnpm run build:ts && node ./dist/bin/cargo.js build --release",
    "check": "pnpm run build:ts && node ./dist/bin/cargo.js check",
    "test": "pnpm run build:ts && node ./dist/bin/cargo.js test"
  },
  "packageManager": "pnpm@10.33.1",
  "devDependencies": {
    "@types/node": "^25.8.0",
    "typescript": "^6.0.3"
  }
}
